// 20) * Входное слово представляет собой два троичных числа без
// знака, разделенные знаком "^". Обменять числа местами.

// Шифровка цифр и перемещение "^" налево
0^->^z
1^->^o
2^->^t
// Перемещение указателя
>0->0>
>1->1>
>2->2>
// Перемещение незашифрованных цифр налево
z0->0z
z1->1z
z2->2z
o0->0o
o1->1o
o2->2o
t0->0t
t1->1t
t2->2t
// Превращение "^" в правый указатель
 ^->>
// Правый указатель разделяет цифры на стыке и преобразуется в левый
0>->0s<
1>->1s<
2>->2s<
// Левый указатель дешифрует цифры
<z->0<
<o->1<
<t->2<
// Удаление левого указателя по достижении края
<-> 
// Терминальная замена разделителя на "^"
s=>^
